{
  "name": "frape-club",
  "version": "1.0.0",
  "description": "Sistema financiero de Frape Club - ingresos, gastos, activos, accionistas y cobros",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node db/init.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "nodemonConfig": {
    "watch": ["server.js", "db", "middleware", "routes", "lib", "views", ".env"],
    "ext": "js,ejs,env"
  }
}
