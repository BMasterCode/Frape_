<%- include('../partials/header', { titulo: 'Admin - Frape Club' }) %>

<h1>Panel de Administrador</h1>

<% if (error) { %><div class="mensaje-error"><%= error %></div><% } %>
<% if (mensaje) { %><div class="mensaje-ok"><%= mensaje %></div><% } %>

<div class="tarjeta">
  <h2 style="margin-top:0">Crear nuevo usuario</h2>
  <form action="<%= ADMIN_BASE %>/usuarios" method="POST">
    <div class="fila">
      <div class="campo">
        <label for="nombre">Nombre completo</label>
        <input type="text" id="nombre" name="nombre" required />
      </div>
      <div class="campo">
        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" required />
      </div>
      <div class="campo">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required minlength="4" />
      </div>
    </div>
    <button type="submit">Crear usuario</button>
  </form>
</div>

<div class="tarjeta">
  <h2 style="margin-top:0">Usuarios</h2>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr><th>Nombre</th><th>Usuario</th><th>Estado</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        <% usuarios.forEach(function(u) { %>
          <tr>
            <td><%= u.nombre %></td>
            <td><%= u.username %></td>
            <td><%= u.activo ? 'Activo' : 'Inactivo' %></td>
            <td>
              <a class="btn btn-pequeno btn-secundario" href="<%= ADMIN_BASE %>/usuarios/<%= u.id %>">Editar / Permisos</a>
              <form action="<%= ADMIN_BASE %>/usuarios/<%= u.id %>/eliminar" method="POST" style="display:inline"
                    onsubmit="return confirm('¿Eliminar a <%= u.nombre %>? Esta acción no se puede deshacer.');">
                <button type="submit" class="btn-pequeno btn-peligro">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (usuarios.length === 0) { %>
          <tr><td colspan="4">Todavía no has creado usuarios.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
