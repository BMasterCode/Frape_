<% const p = pestanas.find(x => x.clave === 'menu'); const puedeEditar = p && p.puede_editar; %>
<%- include('../partials/header', { titulo: 'Menú - Frape Club', pestanaActiva: 'menu' }) %>

<h1>Menú de Productos</h1>
<p style="color:var(--color-texto-suave); font-size:0.9rem; margin-top:-8px;">
  Define aquí cada frappe/refresco y masita/snack. Al venderlos en "Ingresos y Gastos" el sistema
  descuenta solo los insumos del inventario.
</p>

<% if (puedeEditar) { %>
<div class="tarjeta">
  <h2 style="margin-top:0">Agregar producto al menú</h2>
  <form action="/menu" method="POST" id="formMenu">
    <div class="fila">
      <div class="campo">
        <label for="nombre">Nombre del producto</label>
        <input type="text" id="nombre" name="nombre" required placeholder="Ej: Frappe de café" />
      </div>
      <div class="campo">
        <label for="categoria">Categoría</label>
        <select id="categoria" name="categoria" required>
          <option value="frappe">Frappe / Refresco</option>
          <option value="masita">Masita / Snack</option>
        </select>
      </div>
      <div class="campo">
        <label for="precio_venta">Precio de venta (Bs)</label>
        <input type="number" step="0.01" min="0" id="precio_venta" name="precio_venta" required />
      </div>
    </div>

    <div class="campo">
      <label for="modo">¿Cómo se obtiene?</label>
      <select id="modo" name="modo" required onchange="cambiarModo()">
        <option value="elaborado">Se elabora aquí (usa insumos del inventario)</option>
        <option value="comprado">Se compra ya hecho y se revende</option>
      </select>
    </div>

    <div id="bloqueComprado" style="display:none;">
      <div class="campo">
        <label for="inventario_id_comprado">Producto en el inventario</label>
        <select id="inventario_id_comprado" name="inventario_id_comprado">
          <option value="">-- Selecciona --</option>
          <% inventario.forEach(function(i) { %>
            <option value="<%= i.id %>"><%= i.nombre %> (stock: <%= fmt(i.stock) %> <%= i.unidad %>)</option>
          <% }) %>
        </select>
        <p style="font-size:0.8rem; color:var(--color-texto-suave); margin:4px 0 0;">
          Cada venta descuenta 1 unidad de este producto del inventario.
        </p>
      </div>
    </div>

    <div id="bloqueElaborado">
      <label style="display:block; margin-bottom:6px;">Insumos que necesita (por 1 unidad vendida)</label>
      <div id="filasReceta"></div>
      <button type="button" class="btn-secundario btn-pequeno" onclick="agregarFilaReceta()">+ Agregar insumo</button>
    </div>

    <button type="submit" style="margin-top:16px;">Guardar producto</button>
  </form>
</div>
<% } %>

<div class="buscador">
  <input type="text" id="buscarMenu" placeholder="Buscar por nombre..." />
</div>

<div class="tarjeta">
  <h2 style="margin-top:0">Frappes / Refrescos</h2>
  <div class="tabla-scroll">
    <table id="tablaMenuFrappe">
      <thead><tr><th>Producto</th><th>Precio</th><th>Origen</th><th>Detalle</th><% if (puedeEditar) { %><th></th><% } %></tr></thead>
      <tbody>
        <% productos.filter(x => x.categoria === 'frappe').forEach(function(prod) { %>
          <tr data-nombre="<%= prod.nombre.toLowerCase() %>">
            <td><%= prod.nombre %></td>
            <td>Bs <%= Number(prod.precio_venta).toFixed(2) %></td>
            <td><%= prod.modo === 'elaborado' ? 'Elaborado' : 'Comprado' %></td>
            <td>
              <% if (prod.modo === 'comprado') { %>
                <%= prod.insumo_comprado_nombre || '-' %>
              <% } else { %>
                <% prod.receta.forEach(function(r) { %>
                  <div><%= fmt(r.cantidad_necesaria) %> <%= r.insumo_unidad %> de <%= r.insumo_nombre %></div>
                <% }) %>
              <% } %>
            </td>
            <% if (puedeEditar) { %>
            <td><form action="/menu/<%= prod.id %>/eliminar" method="POST" onsubmit="return confirm('¿Quitar del menú?');"><button class="btn-pequeno btn-peligro">Quitar</button></form></td>
            <% } %>
          </tr>
        <% }) %>
        <% if (productos.filter(x => x.categoria === 'frappe').length === 0) { %>
          <tr><td colspan="5">Todavía no hay frappes/refrescos en el menú.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="tarjeta">
  <h2 style="margin-top:0">Masitas / Snacks</h2>
  <div class="tabla-scroll">
    <table id="tablaMenuMasita">
      <thead><tr><th>Producto</th><th>Precio</th><th>Origen</th><th>Detalle</th><% if (puedeEditar) { %><th></th><% } %></tr></thead>
      <tbody>
        <% productos.filter(x => x.categoria === 'masita').forEach(function(prod) { %>
          <tr data-nombre="<%= prod.nombre.toLowerCase() %>">
            <td><%= prod.nombre %></td>
            <td>Bs <%= Number(prod.precio_venta).toFixed(2) %></td>
            <td><%= prod.modo === 'elaborado' ? 'Elaborado' : 'Comprado' %></td>
            <td>
              <% if (prod.modo === 'comprado') { %>
                <%= prod.insumo_comprado_nombre || '-' %>
              <% } else { %>
                <% prod.receta.forEach(function(r) { %>
                  <div><%= fmt(r.cantidad_necesaria) %> <%= r.insumo_unidad %> de <%= r.insumo_nombre %></div>
                <% }) %>
              <% } %>
            </td>
            <% if (puedeEditar) { %>
            <td><form action="/menu/<%= prod.id %>/eliminar" method="POST" onsubmit="return confirm('¿Quitar del menú?');"><button class="btn-pequeno btn-peligro">Quitar</button></form></td>
            <% } %>
          </tr>
        <% }) %>
        <% if (productos.filter(x => x.categoria === 'masita').length === 0) { %>
          <tr><td colspan="5">Todavía no hay masitas/snacks en el menú.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const inventarioDisponible = <%- JSON.stringify(inventario.map(i => ({ id: i.id, nombre: i.nombre, unidad: i.unidad }))) %>;

  function cambiarModo() {
    const modo = document.getElementById('modo').value;
    document.getElementById('bloqueComprado').style.display = modo === 'comprado' ? 'block' : 'none';
    document.getElementById('bloqueElaborado').style.display = modo === 'elaborado' ? 'block' : 'none';
  }

  function agregarFilaReceta() {
    const cont = document.getElementById('filasReceta');
    const fila = document.createElement('div');
    fila.className = 'fila';
    fila.style.alignItems = 'flex-end';

    let opciones = '<option value="">-- Insumo --</option>';
    inventarioDisponible.forEach(function (i) {
      opciones += `<option value="${i.id}">${i.nombre} (${i.unidad})</option>`;
    });

    fila.innerHTML = `
      <div class="campo" style="flex:2;">
        <label>Insumo</label>
        <select name="insumo_id">${opciones}</select>
      </div>
      <div class="campo">
        <label>Cantidad necesaria</label>
        <input type="number" step="0.001" min="0" name="cantidad_necesaria" />
      </div>
      <button type="button" class="btn-pequeno btn-peligro" onclick="this.parentElement.remove()">Quitar</button>
    `;
    cont.appendChild(fila);
  }

  if (document.getElementById('formMenu')) {
    cambiarModo();
    agregarFilaReceta();
  }

  activarBuscador('buscarMenu', 'tablaMenuFrappe', 'tablaMenuMasita');
</script>

<%- include('../partials/footer') %>
