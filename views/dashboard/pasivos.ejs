<% const p = pestanas.find(x => x.clave === 'pasivos'); const puedeEditar = p && p.puede_editar; %>
<%- include('../partials/header', { titulo: 'Pasivos - Frape Club', pestanaActiva: 'pasivos' }) %>

<h1>Pasivos (Deudas por Pagar)</h1>
<p style="color:var(--color-texto-suave); font-size:0.9rem; margin-top:-8px;">
  Lo que esté pendiente aquí alimenta directamente el Balance General.
</p>

<div class="resumen-grid">
  <div class="resumen-card gasto">
    <div>Sueldos por pagar</div>
    <div class="valor">Bs <%= totales.sueldos_pagar.toFixed(2) %></div>
  </div>
  <div class="resumen-card gasto">
    <div>Cuentas / intereses por pagar</div>
    <div class="valor">Bs <%= totales.cuentas_pagar.toFixed(2) %></div>
  </div>
  <div class="resumen-card gasto">
    <div>Total pendiente</div>
    <div class="valor">Bs <%= totales.total.toFixed(2) %></div>
  </div>
</div>

<% if (puedeEditar) { %>
<div class="tarjeta">
  <h2 style="margin-top:0">Registrar deuda</h2>
  <form action="/pasivos" method="POST">
    <div class="fila">
      <div class="campo">
        <label for="descripcion">Descripción</label>
        <input type="text" id="descripcion" name="descripcion" required placeholder="Ej: Sueldo de Christian - agosto" />
      </div>
      <div class="campo">
        <label for="tipo">Tipo</label>
        <select id="tipo" name="tipo" required>
          <option value="sueldo">Sueldo no pagado</option>
          <option value="cuenta">Cuenta por pagar</option>
          <option value="interes">Interés</option>
          <option value="otro">Otro</option>
        </select>
      </div>
      <div class="campo">
        <label for="monto">Monto (Bs)</label>
        <input type="number" step="0.01" min="0" id="monto" name="monto" required />
      </div>
    </div>
    <button type="submit">Registrar</button>
  </form>
</div>
<% } %>

<div class="tarjeta">
  <h2 style="margin-top:0">Listado</h2>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr><th>Descripción</th><th>Tipo</th><th>Monto</th><th>Estado</th><% if (puedeEditar) { %><th></th><% } %></tr>
      </thead>
      <tbody>
        <% const nombresTipo = { sueldo: 'Sueldo', cuenta: 'Cuenta por pagar', interes: 'Interés', otro: 'Otro' }; %>
        <% pasivos.forEach(function(d) { %>
          <tr>
            <td><%= d.descripcion %></td>
            <td><%= nombresTipo[d.tipo] %></td>
            <td>Bs <%= Number(d.monto).toFixed(2) %></td>
            <td>
              <% if (d.pagado) { %>
                <span class="badge ingreso">Pagado</span>
              <% } else { %>
                <span class="badge gasto">Pendiente</span>
              <% } %>
            </td>
            <% if (puedeEditar) { %>
            <td class="fila" style="gap:6px; flex-wrap:nowrap;">
              <% if (!d.pagado) { %>
                <form action="/pasivos/<%= d.id %>/pagado" method="POST" onsubmit="return confirm('¿Marcar como pagado?');">
                  <button type="submit" class="btn-pequeno">Pagado</button>
                </form>
              <% } %>
              <form action="/pasivos/<%= d.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar este registro?');">
                <button type="submit" class="btn-pequeno btn-peligro">Eliminar</button>
              </form>
            </td>
            <% } %>
          </tr>
        <% }) %>
        <% if (pasivos.length === 0) { %>
          <tr><td colspan="5">No hay deudas registradas.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
