<% const p = pestanas.find(x => x.clave === 'ingresos_gastos'); const puedeEditar = p && p.puede_editar; %>
<%- include('../partials/header', { titulo: 'Ingresos y Gastos - Frape Club', pestanaActiva: 'ingresos_gastos' }) %>

<h1>Ingresos y Gastos del Día</h1>

<% if (esAdmin) { %>
<form method="GET" action="/ingresos-gastos" class="fila" style="align-items:flex-end; margin-bottom:16px;">
  <div class="campo" style="max-width:200px;">
    <label for="fecha">Fecha</label>
    <input type="date" id="fecha" name="fecha" value="<%= fecha %>" onchange="this.form.submit()" />
  </div>
</form>
<% } else { %>
<p style="color:var(--color-texto-suave); font-size:0.9rem;">
  Fecha de hoy: <strong><%= fecha %></strong>
</p>
<% } %>

<div class="resumen-grid">
  <div class="resumen-card ingreso">
    <div>Ingresos del día</div>
    <div class="valor">Bs <%= Number(totalesDia.ingresos).toFixed(2) %></div>
  </div>
  <div class="resumen-card gasto">
    <div>Gastos del día</div>
    <div class="valor">Bs <%= Number(totalesDia.gastos).toFixed(2) %></div>
  </div>
  <div class="resumen-card ingreso">
    <div>Ingresos del mes</div>
    <div class="valor">Bs <%= Number(totalesMes.ingresos).toFixed(2) %></div>
  </div>
  <div class="resumen-card gasto">
    <div>Gastos del mes</div>
    <div class="valor">Bs <%= Number(totalesMes.gastos).toFixed(2) %></div>
  </div>
</div>

<% if (puedeEditar) { %>
<div class="tarjeta">
  <h2 style="margin-top:0">Registrar movimiento</h2>
  <form id="formMovimiento" action="/ingresos-gastos" method="POST">
    <input type="hidden" name="fecha" value="<%= fecha %>" />
    <div class="fila">
      <div class="campo">
        <label for="tipo">Tipo</label>
        <select id="tipo" name="tipo" required onchange="actualizarServicios()">
          <option value="ingreso">Ingreso</option>
          <option value="gasto">Gasto</option>
        </select>
      </div>
      <div class="campo">
        <label for="servicio">Servicio / Categoría</label>
        <select id="servicio" name="servicio" required onchange="actualizarCamposServicio()"></select>
      </div>
    </div>

    <!-- Frappe / Masita: se busca el producto escribiendo su nombre -->
    <!-- Juegos: se busca el juego de la misma forma (sin "cantidad") -->
    <div class="fila" id="campoProducto" style="display:none;">
      <div class="campo" style="flex:2; position:relative;">
        <label id="labelProducto" for="productoBusqueda">Producto</label>
        <input type="text" id="productoBusqueda" autocomplete="off" placeholder="Escribe para buscar..." oninput="buscarProducto()" onfocus="buscarProducto()" />
        <input type="hidden" id="producto_id" name="producto_id" />
        <div id="productoResultados" class="autocomplete-resultados"></div>
      </div>
      <div class="campo" id="campoCantidadProducto">
        <label for="cantidad">Cantidad vendida</label>
        <input type="number" step="1" min="1" id="cantidad" name="cantidad" value="1" oninput="calcularMontoProducto()" />
      </div>
    </div>

    <!-- Juegos: horas / personas / tarifa -->
    <div class="fila" id="camposJuego" style="display:none;">
      <div class="campo">
        <label for="horas">Horas</label>
        <input type="number" step="0.25" min="0" id="horas" name="horas" oninput="calcularMonto()" />
      </div>
      <div class="campo" id="campoPersonas" style="display:none;">
        <label for="personas">Personas</label>
        <input type="number" step="1" min="0" id="personas" name="personas" oninput="calcularMonto()" />
      </div>
      <div class="campo">
        <label for="tarifa">Tarifa por hora (Bs)</label>
        <input type="number" step="0.01" min="0" id="tarifa" name="tarifa" oninput="calcularMonto()" />
      </div>
    </div>

    <div class="fila">
      <div class="campo">
        <label for="descripcion">Descripción (opcional)</label>
        <input type="text" id="descripcion" name="descripcion" />
      </div>
      <div class="campo">
        <label for="monto">Monto (Bs)</label>
        <input type="number" step="0.01" min="0" id="monto" name="monto" required />
      </div>
    </div>

    <button type="submit">Guardar movimiento</button>
  </form>
</div>
<% } %>

<div class="tarjeta">
  <h2 style="margin-top:0">Movimientos del <%= fecha %></h2>
  <p style="font-size:0.8rem; color:var(--color-texto-suave); margin-top:-8px;">Toca un movimiento para ver el detalle completo.</p>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr><th>Hora</th><th>Tipo</th><th>Producto / Juego</th><th>Monto</th><% if (puedeEditar) { %><th></th><% } %></tr>
      </thead>
      <tbody>
        <% movimientos.forEach(function(m) { %>
          <tr onclick="mostrarDetalle(<%= m.id %>)" style="cursor:pointer;">
            <td><%= new Date(m.creado_en).toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit', timeZone: 'America/La_Paz' }) %></td>
            <td><span class="badge <%= m.tipo %>"><%= m.tipo === 'ingreso' ? 'Ingreso' : 'Gasto' %></span></td>
            <td><%= m.producto_nombre || (serviciosIngreso[m.servicio] || serviciosGasto[m.servicio] || m.servicio) %></td>
            <td>Bs <%= Number(m.monto).toFixed(2) %></td>
            <% if (puedeEditar) { %>
            <td>
              <form action="/ingresos-gastos/<%= m.id %>/eliminar" method="POST" onclick="event.stopPropagation()" onsubmit="return confirm('¿Eliminar este movimiento?');">
                <button type="submit" class="btn-pequeno btn-peligro">Eliminar</button>
              </form>
            </td>
            <% } %>
          </tr>
        <% }) %>
        <% if (movimientos.length === 0) { %>
          <tr><td colspan="5">Sin movimientos registrados este día.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal de detalle -->
<div id="overlayDetalle" class="overlay-menu"></div>
<div id="modalDetalle" class="modal-detalle">
  <div class="modal-detalle-header">
    <span>Detalle del movimiento</span>
    <button type="button" id="btnCerrarDetalle" aria-label="Cerrar">✕</button>
  </div>
  <div id="modalDetalleContenido"></div>
</div>

<script>
  const serviciosIngreso = <%- JSON.stringify(serviciosIngreso) %>;
  const serviciosGasto = <%- JSON.stringify(serviciosGasto) %>;
  const serviciosConJuego = ['juego_cartas', 'juego_mesa_persona'];
  const serviciosConPersonas = ['juego_mesa_persona'];
  const serviciosConProductoSimple = ['frappe', 'masita'];
  const menu = <%- JSON.stringify(menu.map(m => ({ id: m.id, nombre: m.nombre, categoria: m.categoria, precio_venta: Number(m.precio_venta) }))) %>;

  function actualizarServicios() {
    const tipo = document.getElementById('tipo').value;
    const select = document.getElementById('servicio');
    const lista = tipo === 'ingreso' ? serviciosIngreso : serviciosGasto;
    select.innerHTML = '';
    Object.keys(lista).forEach(function (clave) {
      const opt = document.createElement('option');
      opt.value = clave;
      opt.textContent = lista[clave];
      select.appendChild(opt);
    });
    actualizarCamposServicio();
  }

  let opcionesProductoActuales = [];

  function actualizarOpcionesProducto(servicio) {
    opcionesProductoActuales = menu.filter(function (m) { return m.categoria === servicio; });
    document.getElementById('productoBusqueda').value = '';
    document.getElementById('producto_id').value = '';
    document.getElementById('productoResultados').innerHTML = '';
    document.getElementById('productoResultados').style.display = 'none';
  }

  function buscarProducto() {
    const servicio = document.getElementById('servicio').value;
    const q = document.getElementById('productoBusqueda').value.trim().toLowerCase();
    const cont = document.getElementById('productoResultados');
    cont.innerHTML = '';
    document.getElementById('producto_id').value = '';

    const coincidencias = opcionesProductoActuales.filter(function (m) {
      return m.nombre.toLowerCase().includes(q);
    });

    if (coincidencias.length === 0) {
      cont.style.display = 'none';
      return;
    }

    coincidencias.forEach(function (m) {
      const item = document.createElement('div');
      item.className = 'autocomplete-item';
      item.textContent = serviciosConProductoSimple.includes(servicio)
        ? m.nombre + ' (Bs ' + m.precio_venta.toFixed(2) + ')'
        : m.nombre;
      item.onclick = function () {
        document.getElementById('producto_id').value = m.id;
        document.getElementById('productoBusqueda').value = m.nombre;
        document.getElementById('productoBusqueda').dataset.precio = m.precio_venta;
        cont.innerHTML = '';
        cont.style.display = 'none';
        calcularMontoProducto();
      };
      cont.appendChild(item);
    });
    cont.style.display = 'block';
  }

  document.addEventListener('click', function (e) {
    const cont = document.getElementById('productoResultados');
    const input = document.getElementById('productoBusqueda');
    if (cont && input && e.target !== input && !cont.contains(e.target)) {
      cont.style.display = 'none';
    }
  });

  function calcularMontoProducto() {
    const precio = parseFloat(document.getElementById('productoBusqueda').dataset.precio) || 0;
    const cantidad = parseFloat(document.getElementById('cantidad').value) || 0;
    document.getElementById('monto').value = (precio * cantidad).toFixed(2);
  }

  function actualizarCamposServicio() {
    const servicio = document.getElementById('servicio').value;
    const conProducto = serviciosConProductoSimple.includes(servicio);
    const conJuego = serviciosConJuego.includes(servicio);
    const conPersonas = serviciosConPersonas.includes(servicio);

    document.getElementById('campoProducto').style.display = (conProducto || conJuego) ? 'flex' : 'none';
    document.getElementById('labelProducto').textContent = conJuego ? 'Juego' : 'Producto';
    document.getElementById('campoCantidadProducto').style.display = conProducto ? 'block' : 'none';
    document.getElementById('cantidad').disabled = !conProducto;
    if (!conProducto) document.getElementById('cantidad').value = '';

    document.getElementById('camposJuego').style.display = conJuego ? 'flex' : 'none';
    document.getElementById('campoPersonas').style.display = conPersonas ? 'block' : 'none';

    if (conProducto || conJuego) {
      actualizarOpcionesProducto(servicio);
    }
    if (conProducto) {
      calcularMontoProducto();
    } else if (conJuego) {
      calcularMonto();
    }
  }

  function calcularMonto() {
    const servicio = document.getElementById('servicio').value;
    if (!serviciosConJuego.includes(servicio)) return;
    const horas = parseFloat(document.getElementById('horas').value) || 0;
    const tarifa = parseFloat(document.getElementById('tarifa').value) || 0;
    let monto = horas * tarifa;
    if (serviciosConPersonas.includes(servicio)) {
      const personas = parseFloat(document.getElementById('personas').value) || 0;
      monto = horas * tarifa * personas;
    }
    document.getElementById('monto').value = monto.toFixed(2);
  }

  if (document.getElementById('formMovimiento')) {
    actualizarServicios();
  }

  // ---------- Modal de detalle ----------
  const detalles = <%- JSON.stringify(
    movimientos.reduce(function (acc, m) {
      acc[m.id] = {
        tipo: m.tipo,
        servicio: serviciosIngreso[m.servicio] || serviciosGasto[m.servicio] || m.servicio,
        producto: m.producto_nombre || null,
        cantidad: m.cantidad,
        horas: m.horas,
        personas: m.personas,
        tarifa: m.tarifa,
        descripcion: m.descripcion,
        monto: m.monto,
        usuario: m.usuario_nombre || null,
        creado_en: m.creado_en,
      };
      return acc;
    }, {})
  ) %>;

  function filaDetalle(etiqueta, valor) {
    return '<div class="detalle-fila"><span>' + etiqueta + '</span><span>' + valor + '</span></div>';
  }

  function fmtNumCliente(n) {
    return Number(n).toLocaleString('es-BO', { maximumFractionDigits: 3 });
  }

  function mostrarDetalle(id) {
    const d = detalles[id];
    if (!d) return;
    const horaTexto = new Date(d.creado_en).toLocaleString('es-BO', {
      day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit',
      timeZone: 'America/La_Paz',
    });

    let html = '';
    html += filaDetalle('Fecha y hora', horaTexto);
    html += filaDetalle('Tipo', d.tipo === 'ingreso' ? 'Ingreso' : 'Gasto');
    html += filaDetalle('Servicio', d.servicio);
    if (d.producto) html += filaDetalle('Producto / Juego', d.producto);
    if (d.cantidad) html += filaDetalle('Cantidad', fmtNumCliente(d.cantidad));
    if (d.horas) html += filaDetalle('Horas jugadas', fmtNumCliente(d.horas));
    if (d.personas) html += filaDetalle('Personas', fmtNumCliente(d.personas));
    if (d.tarifa) html += filaDetalle('Tarifa por hora', 'Bs ' + Number(d.tarifa).toFixed(2));
    if (d.descripcion) html += filaDetalle('Descripción', d.descripcion);
    html += filaDetalle('Monto', 'Bs ' + Number(d.monto).toFixed(2));
    if (d.usuario) html += filaDetalle('Registrado por', d.usuario);

    document.getElementById('modalDetalleContenido').innerHTML = html;
    document.getElementById('modalDetalle').classList.add('abierto');
    document.getElementById('overlayDetalle').classList.add('visible');
  }

  function cerrarDetalle() {
    document.getElementById('modalDetalle').classList.remove('abierto');
    document.getElementById('overlayDetalle').classList.remove('visible');
  }

  document.getElementById('btnCerrarDetalle').addEventListener('click', cerrarDetalle);
  document.getElementById('overlayDetalle').addEventListener('click', cerrarDetalle);
</script>

<%- include('../partials/footer') %>
