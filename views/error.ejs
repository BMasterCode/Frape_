<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Frape Club</title>
  <link rel="stylesheet" href="/public/css/styles.css" />
</head>
<body>
  <div class="pagina-login">
    <div class="tarjeta">
      <h1>Frape Club</h1>
      <p><%= mensaje %></p>
      <a href="/" class="btn">Volver al inicio</a>
      <% if (typeof esAdmin !== 'undefined' && esAdmin) { %>
        <form action="<%= ADMIN_BASE %>/logout" method="POST" style="margin-top:10px;">
          <button type="submit" class="btn-secundario" style="width:100%;">Cerrar sesión</button>
        </form>
      <% } else if (typeof usuarioActual !== 'undefined' && usuarioActual) { %>
        <form action="/logout" method="POST" style="margin-top:10px;">
          <button type="submit" class="btn-secundario" style="width:100%;">Cerrar sesión</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>
